{
  "name": "@talkoda/cli",
  "version": "0.2.0",
  "description": "The command-line client for Talkoda conversation music.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "talkoda": "bin/talkoda.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
