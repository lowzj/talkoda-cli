    "@strudel/web": "1.3.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "music-metadata": "11.15.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "pi": {
    "skills": [
      "./skills/talkoda"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lowzj/talkoda-cli.git"
  }
